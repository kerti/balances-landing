---
import '../styles/global.css';
import Reveal from '../components/Reveal.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Track your household’s net worth from one balance per account, entered once a month.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const ogImageAlt =
  'Balances: track your household’s net worth without itemising a single transaction.';

// Structured data for search engines. Claims here follow the same discipline
// as the page copy (CONTEXT.md): durable core only, no hosted-signup implication.
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Balances',
  url: Astro.site?.toString(),
  description,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web (self-hosted)',
  license: 'https://github.com/kerti/balances-v2/blob/main/LICENSE',
  sameAs: ['https://github.com/kerti/balances-v2'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Apply a saved theme choice before first paint (see ThemeToggle.astro). -->
    <script is:inline>
      try {
        const theme = localStorage.getItem('balances-landing-theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {
        // Storage blocked: fall back to the OS theme.
      }
    </script>
    <!-- Scroll-triggered motion (see Reveal.astro): with JS and motion allowed,
         [data-reveal] animations wait paused until they scroll into view. If the
         observer never starts, the failsafe drops the gate and they just play. -->
    <script is:inline>
      if (
        'IntersectionObserver' in window &&
        matchMedia('(prefers-reduced-motion: no-preference)').matches
      ) {
        document.documentElement.classList.add('motion');
        setTimeout(() => {
          if (!window.__revealReady) document.documentElement.classList.remove('motion');
        }, 2500);
      }
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Balances" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="2560" />
    <meta property="og:image:height" content="1280" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <Reveal />
  </body>
</html>
