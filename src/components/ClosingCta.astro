---
import { DEMO_URL, SELF_HOST_URL } from '../consts';
---

<!-- The page's one tinted band (--section-tint), ending on the hero's two
     calls to action and its demo caveat. -->
<section>
  <div class="container">
    <p class="eyebrow" data-reveal="up">
      Get started
    </p>
    <h2 data-reveal="up" style="--reveal-delay: 0.08s">
      Start with <span class="accent">this month’s balances.</span>
    </h2>
    <p class="lede" data-reveal="up" style="--reveal-delay: 0.16s">
      Look around the demo first, or run your own copy today.
    </p>
    <div class="cta" data-reveal="up" style="--reveal-delay: 0.24s">
      <a class="button button-primary" href={DEMO_URL} target="_blank" rel="noopener noreferrer">
        Try the live demo
      </a>
      <a
        class="button button-secondary"
        href={SELF_HOST_URL}
        target="_blank"
        rel="noopener noreferrer"
      >
        Self-host it
      </a>
    </div>
    <p class="caveat">No signup. The demo is a shared account, and its data resets nightly.</p>
  </div>
</section>

<style>
  section {
    border-top: 1px solid var(--border);
    background: var(--section-tint);
  }

  .container {
    padding-block: var(--section-pad-top) 4.5rem;
    text-align: center;
  }

  h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--secondary-foreground);
  }

  .lede {
    margin-top: 1.25rem;
    font-size: 1.0625rem;
    color: var(--muted-foreground);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* In dark mode the band is --secondary, the secondary button's own fill;
     the page background keeps the button distinct on the tint. */
  .button-secondary {
    background: var(--background);
  }

  .button-secondary:hover {
    background: var(--accent);
  }

  .caveat {
    margin-top: 0.875rem;
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }
</style>
