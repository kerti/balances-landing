---
// The idea, not the interface: twelve month-end snapshots of net worth, the
// brass line with one dot per month-end. Shapes are generated at build time
// from an illustrative series; there are no real figures, so nothing here can
// go stale.
//
// The card is a window onto a longer line. On wide screens a backdrop behind
// the card carries the same line across the hero: the months before this year
// run out of the card's left edge as a faint line back to a first month-end
// three years ago, and the hero is tinted above it.
const netWorth = [90, 95, 93, 100, 106, 104, 112, 119, 117, 126, 134, 143];

const width = 600;
const height = 380;
const pad = { x: 24, top: 24, bottom: 20 };
const min = Math.min(...netWorth) - 40;
const max = Math.max(...netWorth) + 15;
const baseline = height - pad.bottom;

const toPoints = (series: number[]) =>
  series.map((value, i) => ({
    x: pad.x + (i * (width - 2 * pad.x)) / (series.length - 1),
    y: pad.top + ((max - value) / (max - min)) * (baseline - pad.top),
  }));
const toPath = (pts: { x: number; y: number }[]) =>
  pts.map((p, i) => `${i ? 'L' : 'M'}${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' ');

const points = toPoints(netWorth);
// The months before the card, walked back from its first month to a first
// month-end three years before this one, with a repeating set of monthly
// falls so the line stays believably uneven. The few months just before the
// card climb more steeply, a burst before the year the card shows.
const steps = [4, 2, 5, 3, -1, 4, 3, 5, 2, 4, -1, 4];
const burst = [7, 9, 7, 8];
const history: number[] = [];
for (let i = 0, value = netWorth[0]; i < 36 - (netWorth.length - 1); i++) {
  value -= burst[i] ?? steps[i % steps.length];
  history.unshift(value);
}
const step = (width - 2 * pad.x) / (netWorth.length - 1);
const earlier = [...history, netWorth[0]].map((value, i) => ({
  x: pad.x + (i - history.length) * step,
  y: pad.top + ((max - value) / (max - min)) * (baseline - pad.top),
}));
const earlierLine = toPath(earlier);
const earlierStart = earlier[0].x;
const first = earlier[0];
const now = points.at(-1)!;
// Far enough out to reach the window edge at any width; the hero clips it.
const far = 4000;
// The tint above the line. It fades out across the card (see #hero-tint), so
// the right of the screen stays the plain page background.
const above = [
  `M${earlierStart - far} ${earlier[0].y.toFixed(1)}`,
  toPath([...earlier, ...points.slice(1)]).replace(/^M/, 'L'),
  `L${now.x + far} ${now.y.toFixed(1)} L${now.x + far} ${-far} L${earlierStart - far} ${-far} Z`,
].join(' ');
// The card's edges, roughly: the chart sits inside its 1.5rem padding.
const cardLeft = -40;
const cardRight = width + 40;
// The tint also fades in just before the first month-end, so there is no
// hard edge where the line begins. Offsets along the tint gradient:
const tintFrom = first.x - 160;
const tintAt = (x: number) => ((x - tintFrom) / (cardRight - tintFrom)).toFixed(3);
// Only the shape is drawn: the axis is unlabelled and doesn't start at zero.
// Read as money, the series sits on an offset chosen so the three years grow
// about 16%, roughly 5% a year, in line with the 4–5.5% a year (real) that an
// average Indonesian adult's net wealth typically grows. Shifting the series
// doesn't move a single point of the drawing.
const growth = 0.16;
const offset = (netWorth.at(-1)! - (1 + growth) * history[0]) / growth;
const sinceFirst = (((netWorth.at(-1)! + offset) / (history[0] + offset) - 1) * 100).toFixed(0);
const line = toPath(points);
const area = `${line} L${points.at(-1)!.x} ${baseline} L${points[0].x} ${baseline} Z`;
const grid = [0.25, 0.5, 0.75].map((f) => pad.top + f * (baseline - pad.top));
---

<figure class="illustration" data-reveal>
  <p class="head">
    <span>Net worth</span>
    <span class="sub">The last 12 month-ends</span>
  </p>
  <div class="plot">
    <svg class="backdrop" viewBox={`0 0 ${width} ${height}`} aria-hidden="true">
      <defs>
        <linearGradient
          id="hero-earlier"
          gradientUnits="userSpaceOnUse"
          x1={earlierStart}
          y1="0"
          x2={pad.x}
          y2="0"
        >
          <stop offset="0" style="stop-color: var(--primary); stop-opacity: 0.3"></stop>
          <stop offset="1" style="stop-color: var(--primary); stop-opacity: 0.7"></stop>
        </linearGradient>
        <linearGradient
          id="hero-tint"
          gradientUnits="userSpaceOnUse"
          x1={tintFrom}
          y1="0"
          x2={cardRight}
          y2="0"
        >
          <stop offset="0" style="stop-color: var(--hero-tint); stop-opacity: 0"></stop>
          <stop offset={tintAt(first.x)} style="stop-color: var(--hero-tint)"></stop>
          <stop offset={tintAt(cardLeft)} style="stop-color: var(--hero-tint)"></stop>
          <stop offset="1" style="stop-color: var(--hero-tint); stop-opacity: 0"></stop>
        </linearGradient>
      </defs>
      <path class="above" d={above}></path>
      <path class="earlier" d={earlierLine} stroke="url(#hero-earlier)"></path>
      <circle class="first" cx={first.x} cy={first.y} r="6"></circle>
      <text class="first-label" x={first.x - 6} y={first.y + 34}>
        <tspan>First month-end</tspan>
        <tspan class="first-when" x={first.x - 6} dy="22">
          3 years ago
        </tspan>
      </text>
    </svg>
    <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby="hero-illustration-title">
      <title id="hero-illustration-title">
      Twelve monthly snapshots of net worth, climbing month by month
    </title>
      <defs>
        <linearGradient id="hero-area" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" style="stop-color: var(--primary); stop-opacity: 0.22"></stop>
          <stop offset="1" style="stop-color: var(--primary); stop-opacity: 0"></stop>
        </linearGradient>
      </defs>
      {grid.map((y) => (
        <line class="grid" x1={pad.x} x2={width - pad.x} y1={y} y2={y} />
      ))}
      <line class="axis" x1={pad.x} x2={width - pad.x} y1={baseline} y2={baseline} />
      {points.map((p) => (
        <line class="tick" x1={p.x} x2={p.x} y1={p.y} y2={baseline} />
      ))}
      <path class="area" d={area} fill="url(#hero-area)" />
      <line class="crosshair" x1={now.x} x2={now.x} y1={pad.top - 8} y2={baseline} />
      <path class="line" d={line} pathLength="1" />
      {points.map((p, i) => (
        <circle
          class:list={['dot', { now: i === points.length - 1 }]}
          cx={p.x}
          cy={p.y}
          r={i === points.length - 1 ? 9 : 6}
          style={`--i: ${i}`}
        />
      ))}
      <g class="tip" transform={`translate(${now.x - 20} ${now.y - 4})`}>
        <rect x="-226" y="-54" width="226" height="54" rx="9"></rect>
        <text class="tip-date" x="-212" y="-32">
          This month-end
        </text>
        <text class="tip-change" x="-212" y="-11">
          Net worth +{sinceFirst}% in 3 years
        </text>
      </g>
    </svg>
  </div>
  <figcaption>
    <span class="ends">
      <span>A year ago</span>
      <span>This month</span>
    </span>
    <span class="legend">Each dot is one month-end: what you own minus what you owe.</span>
  </figcaption>
</figure>

<style>
  .illustration {
    max-width: 40rem;
    margin: 3.5rem auto 0;
    padding: 1.5rem 1.5rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) * 1.6);
    background: var(--card);
    box-shadow: var(--shot-shadow);
    text-align: left;
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1rem;
    font-weight: 650;
  }

  .sub {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--muted-foreground);
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .grid {
    stroke: var(--border);
    stroke-dasharray: 4 6;
  }

  .axis {
    stroke: var(--border);
  }

  /* The backdrop: same coordinates as the chart, painted behind the card's
     contents (z-index -1 inside the hero's stacking context). Only where the
     card sits beside the copy; stacked, it would cut across the text. There
     the card turns transparent, a frame over the one line, so the earlier
     years run straight into its first month-end. */
  .plot {
    position: relative;
  }

  .backdrop {
    display: none;
    position: absolute;
    inset: 0;
    z-index: -1;
    height: 100%;
  }

  @media (min-width: 64rem) {
    .backdrop {
      display: block;
    }

    .illustration {
      background: transparent;
      box-shadow: none;
    }
  }

  /* Above the line the hero takes the darker tint, fading out across the
     card; below it stays the page background, so the hero blends into the
     next section. */
  .above {
    fill: url(#hero-tint);
  }

  /* The earlier years: faint and dot-free, strengthening towards the card. */
  .earlier {
    fill: none;
    stroke-width: 2;
    stroke-linejoin: round;
  }

  /* Where the line starts: the household's first month-end. Labelled only
     where the window is wide enough for it to be on screen. */
  .first {
    fill: var(--background);
    stroke: color-mix(in oklch, var(--primary) 45%, transparent);
    stroke-width: 2.5;
  }

  .first-label {
    display: none;
    fill: var(--muted-foreground);
    font-size: 19px;
  }

  .first-when {
    fill: color-mix(in oklch, var(--primary) 70%, var(--muted-foreground));
  }

  @media (min-width: 88rem) {
    .first-label {
      display: inline;
    }
  }

  .crosshair {
    stroke: color-mix(in oklch, var(--primary) 40%, transparent);
    stroke-dasharray: 4 5;
  }

  .tip rect {
    fill: var(--card);
    stroke: var(--border);
  }

  .tip text {
    font-size: 16px;
  }

  .tip-date {
    fill: var(--muted-foreground);
  }

  .tip-change {
    fill: var(--primary);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .tick {
    stroke: color-mix(in oklch, var(--primary) 18%, transparent);
    stroke-dasharray: 2 4;
  }

  .line {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .line {
    stroke: var(--primary);
    stroke-width: 3;
  }

  .dot {
    fill: var(--background);
    stroke: var(--primary);
    stroke-width: 2.5;
  }

  .dot.now {
    fill: var(--primary);
    stroke: color-mix(in oklch, var(--primary) 30%, transparent);
    stroke-width: 10;
    paint-order: stroke;
  }

  figcaption {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--muted-foreground);
  }

  .ends {
    display: flex;
    justify-content: space-between;
  }

  .legend {
    display: block;
    margin-top: 0.5rem;
    text-align: center;
  }

  @media (min-width: 64rem) {
    .illustration {
      margin-top: 0;
    }
  }

  /* The earlier years fade in, net worth draws, then the dots land month by
     month. Motion only; the static drawing is complete without it. */
  @media (prefers-reduced-motion: no-preference) {
    .line {
      stroke-dasharray: 1;
      animation: draw 1.6s ease-out 0.35s both;
    }

    .area {
      animation: fade 0.8s ease-out 1.5s both;
    }

    .backdrop {
      animation: fade 1.2s ease-out both;
    }

    .grid,
    .axis,
    .tick {
      animation: fade 0.8s ease-out 0.2s both;
    }

    .crosshair,
    .tip {
      animation: fade 0.5s ease-out 1.9s both;
    }

    .dot {
      animation: fade 0.35s ease-out both;
      animation-delay: calc(var(--i) * 0.11s + 0.5s);
    }
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }

    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes fade {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }
</style>
