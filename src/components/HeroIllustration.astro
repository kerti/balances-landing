---
// The idea, not the interface: twelve month-end snapshots. Assets run above,
// liabilities shrink below, and net worth is the gap between them, the brass
// line with one dot per month-end. Shapes are generated at build time from an
// illustrative series; there are no real figures, so nothing here can go stale.
const netWorth = [90, 95, 93, 100, 106, 104, 112, 119, 117, 126, 134, 143];
const liabilities = [75, 73, 71, 69, 67, 65, 62, 60, 57, 55, 52, 50];
const assets = netWorth.map((value, i) => value + liabilities[i]);

const width = 600;
const height = 380;
const pad = { x: 24, top: 24, bottom: 20 };
const all = [...assets, ...liabilities, ...netWorth];
const min = Math.min(...all) - 12;
const max = Math.max(...all) + 6;
const baseline = height - pad.bottom;

const toPoints = (series: number[]) =>
  series.map((value, i) => ({
    x: pad.x + (i * (width - 2 * pad.x)) / (series.length - 1),
    y: pad.top + ((max - value) / (max - min)) * (baseline - pad.top),
  }));
const toPath = (pts: { x: number; y: number }[]) =>
  pts.map((p, i) => `${i ? 'L' : 'M'}${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' ');

const points = toPoints(netWorth);
const assetPoints = toPoints(assets);
const liabilityPoints = toPoints(liabilities);
const line = toPath(points);
const assetsLine = toPath(assetPoints);
const liabilitiesLine = toPath(liabilityPoints);
// Direct labels sit just above each supporting line's last point.
const labelX = width - pad.x;
const area = `${line} L${points.at(-1)!.x} ${baseline} L${points[0].x} ${baseline} Z`;
const grid = [0.25, 0.5, 0.75].map((f) => pad.top + f * (baseline - pad.top));
---

<figure class="illustration" data-reveal>
  <p class="head">
    <span>Net worth</span>
    <span class="sub">12 month-ends</span>
  </p>
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby="hero-illustration-title">
    <title id="hero-illustration-title">
      Twelve monthly snapshots: assets rising, liabilities shrinking, and net worth, the gap
      between them, climbing month by month
    </title>
    <defs>
      <linearGradient id="hero-area" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" style="stop-color: var(--primary); stop-opacity: 0.22"></stop>
        <stop offset="1" style="stop-color: var(--primary); stop-opacity: 0"></stop>
      </linearGradient>
    </defs>
    {grid.map((y) => (
      <line class="grid" x1={pad.x} x2={width - pad.x} y1={y} y2={y} />
    ))}
    <line class="axis" x1={pad.x} x2={width - pad.x} y1={baseline} y2={baseline} />
    {points.map((p) => (
      <line class="tick" x1={p.x} x2={p.x} y1={p.y} y2={baseline} />
    ))}
    <path class="area" d={area} fill="url(#hero-area)" />
    <path class="series assets" d={assetsLine} pathLength="1" />
    <path class="series liabilities" d={liabilitiesLine} pathLength="1" />
    <path class="line" d={line} pathLength="1" />
    <text class="label assets" x={labelX} y={assetPoints.at(-1)!.y - 12}>
      Assets
    </text>
    <text class="label liabilities" x={labelX} y={liabilityPoints.at(-1)!.y - 12}>
      Liabilities
    </text>
    {points.map((p, i) => (
      <circle
        class:list={['dot', { now: i === points.length - 1 }]}
        cx={p.x}
        cy={p.y}
        r={i === points.length - 1 ? 9 : 6}
        style={`--i: ${i}`}
      />
    ))}
  </svg>
  <figcaption>
    <span class="ends">
      <span>A year ago</span>
      <span>This month</span>
    </span>
    <span class="legend">Each dot is one month-end: what you own minus what you owe.</span>
  </figcaption>
</figure>

<style>
  .illustration {
    max-width: 40rem;
    margin: 3.5rem auto 0;
    padding: 1.5rem 1.5rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) * 1.6);
    background: color-mix(in oklch, var(--card) 70%, transparent);
    box-shadow: var(--shot-shadow);
    text-align: left;
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1rem;
    font-weight: 650;
  }

  .sub {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--muted-foreground);
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .grid {
    stroke: var(--border);
    stroke-dasharray: 4 6;
  }

  .axis {
    stroke: var(--border);
  }

  .tick {
    stroke: color-mix(in oklch, var(--primary) 18%, transparent);
    stroke-dasharray: 2 4;
  }

  .line,
  .series {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .line {
    stroke: var(--primary);
    stroke-width: 3;
  }

  /* Supporting series: thin and quiet so net worth stays the subject. */
  .series {
    stroke-width: 1.75;
  }

  .assets {
    stroke: var(--chart-assets);
  }

  .liabilities {
    stroke: var(--chart-liabilities);
  }

  /* Each direct label takes its line's colour, so it doubles as the legend. */
  .label {
    font-size: 19px;
    font-weight: 600;
    text-anchor: end;
  }

  .label.assets {
    fill: var(--chart-assets);
    stroke: none;
  }

  .label.liabilities {
    fill: var(--chart-liabilities);
    stroke: none;
  }

  .dot {
    fill: var(--background);
    stroke: var(--primary);
    stroke-width: 2.5;
  }

  .dot.now {
    fill: var(--primary);
    stroke: color-mix(in oklch, var(--primary) 30%, transparent);
    stroke-width: 10;
    paint-order: stroke;
  }

  figcaption {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--muted-foreground);
  }

  .ends {
    display: flex;
    justify-content: space-between;
  }

  .legend {
    display: block;
    margin-top: 0.5rem;
    text-align: center;
  }

  @media (min-width: 64rem) {
    .illustration {
      margin-top: 0;
    }
  }

  /* Assets and liabilities draw first, then net worth, then the dots land
     month by month. Motion only; the static drawing is complete without it. */
  @media (prefers-reduced-motion: no-preference) {
    .series {
      stroke-dasharray: 1;
      animation: draw 1.4s ease-out both;
    }

    .line {
      stroke-dasharray: 1;
      animation: draw 1.6s ease-out 0.35s both;
    }

    .area {
      animation: fade 0.8s ease-out 1.5s both;
    }

    .label {
      animation: fade 0.5s ease-out 1.2s both;
    }

    .dot {
      animation: fade 0.35s ease-out both;
      animation-delay: calc(var(--i) * 0.11s + 0.5s);
    }
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }

    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes fade {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }
</style>
