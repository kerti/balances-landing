---
// Marks [data-reveal] elements with .in-view as they scroll into view, which
// un-pauses their CSS animations (global.css, "Scroll-triggered motion").
// Renders nothing; Layout.astro's head script decides whether motion is gated.
---

<script>
  declare global {
    interface Window {
      __revealReady?: boolean;
    }
  }

  window.__revealReady = true;

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('in-view');
        observer.unobserve(entry.target);
      }
    },
    // Fire once the element's top is 12% above the bottom of the viewport.
    { rootMargin: '0px 0px -12% 0px', threshold: 0 },
  );

  for (const el of document.querySelectorAll('[data-reveal]')) observer.observe(el);
</script>
