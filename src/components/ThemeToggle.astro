---
// Cycles System → Light → Dark. The choice lives only in this browser's
// localStorage (never sent anywhere — ADR-0001 holds); Layout.astro's inline
// head script applies it before first paint. Hidden until this script runs,
// so visitors without JS just get their OS theme.
---

<button class="theme-toggle" type="button" data-mode="system" hidden>
  <svg class="system" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M3 5h18v11H3zM8 20h8M12 16v4"></path>
  </svg>
  <svg class="light" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg class="dark" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"></path>
  </svg>
</button>

<script>
  const KEY = 'balances-landing-theme';
  const MODES = ['system', 'light', 'dark'] as const;
  type Mode = (typeof MODES)[number];

  function read(): Mode {
    try {
      const stored = localStorage.getItem(KEY);
      return stored === 'light' || stored === 'dark' ? stored : 'system';
    } catch {
      return 'system';
    }
  }

  function apply(button: HTMLButtonElement, mode: Mode) {
    const root = document.documentElement;
    if (mode === 'system') delete root.dataset.theme;
    else root.dataset.theme = mode;
    // Point the browser chrome colour at the forced theme, or back at the OS one.
    for (const meta of document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')) {
      const scheme = meta.dataset.scheme;
      if (mode === 'system') meta.media = `(prefers-color-scheme: ${scheme})`;
      else meta.media = scheme === mode ? 'all' : 'not all';
    }
    try {
      if (mode === 'system') localStorage.removeItem(KEY);
      else localStorage.setItem(KEY, mode);
    } catch {
      // Storage blocked (private mode etc.): the choice lasts for this page view.
    }
    const next = MODES[(MODES.indexOf(mode) + 1) % MODES.length];
    button.dataset.mode = mode;
    button.setAttribute('aria-label', `Theme: ${mode}. Switch to ${next}.`);
    button.title = `Theme: ${mode}`;
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('.theme-toggle')) {
    let mode = read();
    apply(button, mode);
    button.hidden = false;
    button.addEventListener('click', () => {
      mode = MODES[(MODES.indexOf(mode) + 1) % MODES.length];
      apply(button, mode);
    });
  }
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: var(--theme-toggle-size, 2.25rem);
    height: var(--theme-toggle-size, 2.25rem);
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--muted-foreground);
    cursor: pointer;
  }

  .theme-toggle[hidden] {
    display: none;
  }

  .theme-toggle:hover {
    color: var(--foreground);
    background: var(--secondary);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  svg {
    display: none;
    width: 50%;
    height: 50%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  [data-mode='system'] .system,
  [data-mode='light'] .light,
  [data-mode='dark'] .dark {
    display: block;
  }
</style>
