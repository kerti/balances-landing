---
import { GITHUB_URL, DEMO_URL, SELF_HOST_URL, LICENSE_URL } from '../consts';
import GithubIcon from './GithubIcon.astro';
---

<footer>
  <div class="container bar">
    <p class="tag">
      <a class="wordmark" href="/">
        <img
          class="wordmark-light"
          src="/brand/wordmark-light.svg"
          alt="Balances"
          width="180"
          height="56"
        />
        <img
          class="wordmark-dark"
          src="/brand/wordmark-dark.svg"
          alt="Balances"
          width="180"
          height="56"
        />
      </a>
      <span>— built in the open.</span>
    </p>
    <nav>
      <a href={DEMO_URL} target="_blank" rel="noopener noreferrer">Demo</a>
      <a href={SELF_HOST_URL} target="_blank" rel="noopener noreferrer">Self-hosting</a>
      <a href={LICENSE_URL} target="_blank" rel="noopener noreferrer">AGPL-3.0</a>
      <a class="gh" href={GITHUB_URL} target="_blank" rel="noopener noreferrer" aria-label="GitHub"
        ><GithubIcon /></a
      >
    </nav>
  </div>
</footer>

<style>
  footer {
    background: var(--background);
    border-top: 1px solid var(--border);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.6875rem;
  }

  .tag {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--muted-foreground);
    font-size: 0.9375rem;
  }

  .tag span {
    /* The geometric correction on the wordmark img (below) lines the two
       baselines up almost exactly; this is a small empirical nudge on top
       of that, since the lighter-weight caption still reads as sitting a
       hair low next to the bold wordmark even once baselines coincide. */
    position: relative;
    top: -1px;
  }

  /* Deliberately not display: inline-flex here. .tag aligns its items on
     the text baseline, and baseline synthesis through a *nested* flex
     container is inconsistently implemented across browsers — it silently
     fell back to this element's own margin-box bottom edge, defeating the
     img's margin-bottom correction below. Left as plain inline content,
     the img's `vertical-align: baseline` (the CSS default, unaffected by
     .tag's flex context once .wordmark isn't itself a flex container) is
     what actually aligns it, and that mechanism is reliable. */
  .wordmark img {
    display: none;
    height: 2.5rem;
    width: auto;
    /* The wordmark SVG's own baseline sits 6 of its 117.98 viewBox units
       above the image's bottom edge (padding below the glyphs) — so the
       default vertical-align: baseline, which plants the image's bottom
       edge on the text baseline, would otherwise leave the copy ~2px
       below the logo's true baseline. Pull the image up to compensate. */
    margin-bottom: calc(-6 / 117.98 * 2.5rem);
  }

  .wordmark img.wordmark-light {
    display: inline;
  }

  @media (prefers-color-scheme: dark) {
    .wordmark img.wordmark-light {
      display: none;
    }

    .wordmark img.wordmark-dark {
      display: inline;
    }
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  .gh {
    display: inline-flex;
  }

  a {
    color: var(--muted-foreground);
    text-decoration: none;
    font-size: 0.9375rem;
  }

  a:hover {
    color: var(--foreground);
  }
</style>
