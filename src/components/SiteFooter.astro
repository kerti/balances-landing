---
import { GITHUB_URL, DEMO_URL, SELF_HOST_URL, LICENSE_URL } from '../consts';
import GithubIcon from './GithubIcon.astro';
---

<footer>
  <div class="container bar">
    <a class="wordmark" href="/">
      <img
        class="wordmark-light light-only"
        src="/brand/wordmark-light.svg"
        alt="Balances"
        width="180"
        height="56"
      />
      <img
        class="wordmark-dark dark-only"
        src="/brand/wordmark-dark.svg"
        alt="Balances"
        width="180"
        height="56"
      />
    </a>
    <nav aria-label="Footer">
      <a href={DEMO_URL} target="_blank" rel="noopener noreferrer">
        Demo
      </a>
      <a href={SELF_HOST_URL} target="_blank" rel="noopener noreferrer">
        Self-hosting
      </a>
      <a href={LICENSE_URL} target="_blank" rel="noopener noreferrer">
        AGPL-3.0
      </a>
      <!-- Attribution required by the Streamline Flex icons' CC BY 4.0 licence. -->
      <a href="https://www.streamlinehq.com" target="_blank" rel="noopener noreferrer">
        Icons by Streamline
      </a>
      <a class="gh" href={GITHUB_URL} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <GithubIcon />
      </a>
    </nav>
  </div>
</footer>

<style>
  footer {
    background: var(--background);
    border-top: 1px solid var(--border);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.6875rem;
  }

  .wordmark {
    display: inline-flex;
  }

  .wordmark img {
    display: block;
    height: 2.5rem;
    width: auto;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  .gh {
    display: inline-flex;
  }

  a {
    color: var(--muted-foreground);
    text-decoration: none;
    font-size: 0.9375rem;
  }

  a:hover {
    color: var(--foreground);
  }
</style>
