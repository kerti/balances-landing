---
import { GITHUB_URL, DEMO_URL } from '../consts';
import GithubIcon from './GithubIcon.astro';
import ThemeToggle from './ThemeToggle.astro';

const sections = [
  { href: '#how-it-works', label: 'How it works' },
  { href: '#why-monthly', label: 'Why monthly' },
  { href: '#what-it-tracks', label: 'What it tracks' },
  { href: '#report', label: 'Report' },
  { href: '#open-source', label: 'Open source' },
];
---

<header>
  <div class="container bar">
    <a class="wordmark" href="#top">
      <img
        class="wordmark-light light-only"
        src="/brand/wordmark-light.svg"
        alt="Balances"
        width="142"
        height="44"
      />
      <img
        class="wordmark-dark dark-only"
        src="/brand/wordmark-dark.svg"
        alt="Balances"
        width="142"
        height="44"
      />
    </a>
    <nav aria-label="Sections">
      <ul class="sections">
        {sections.map((section) => (
          <li>
            <a href={section.href}>{section.label}</a>
          </li>
        ))}
      </ul>
      <ThemeToggle />
      <a class="gh" href={GITHUB_URL} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <GithubIcon />
      </a>
      <a
        class="button button-primary demo"
        href={DEMO_URL}
        target="_blank"
        rel="noopener noreferrer"
      >
        Try the demo
      </a>
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    /* Liquid glass, after Uruni's header-glass: a see-through tint over a
       strong blur with a little saturation, so content passing beneath tints
       the bar instead of vanishing. The light catches the edge that faces the
       content: a bright 1px line just inside the hairline border, with a soft
       glow falling up from it. Dark mode keeps both faint. */
    background-color: color-mix(in oklch, var(--background) 60%, transparent);
    /* Prefixed first: the build's CSS minifier keeps only the last of the
       pair, and Chromium ignores the -webkit- form. */
    -webkit-backdrop-filter: blur(28px) saturate(1.6);
    backdrop-filter: blur(28px) saturate(1.6);
    border-bottom: 1px solid var(--border);
    box-shadow:
      inset 0 -1px 0 light-dark(oklch(1 0 0 / 85%), oklch(1 0 0 / 10%)),
      inset 0 -10px 14px -10px light-dark(oklch(1 0 0 / 70%), oklch(1 0 0 / 6%)),
      0 4px 16px oklch(0.147 0.004 49.25 / 8%);
  }

  .sections {
    display: none;
    gap: 1.5rem;
    margin: 0 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  /* Section links only where all five fit on one line each (about 1024px);
     narrower, the header keeps just the theme switch, the GitHub link and the
     demo button. */
  @media (min-width: 64rem) {
    .sections {
      display: flex;
    }
  }

  .sections a {
    color: var(--muted-foreground);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .sections a:hover {
    color: var(--foreground);
  }

  .sections a:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    /* Fixed, so anchored sections can scroll to exactly beneath it. */
    height: var(--header-height);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
  }

  .wordmark img {
    display: block;
    height: 3rem;
    width: auto;
    /* The white letters sit low in the SVG box (only the brass "l" reaches the
       top, and the baseline has padding below it), so the box-centred image
       reads low next to the nav. Nudge it up; a percentage of its own height
       keeps the correction right at every wordmark size. */
    translate: 0 -8%;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .gh {
    display: inline-flex;
    color: var(--muted-foreground);
    --gh-icon-size: 1.5rem;
  }

  .gh:hover {
    color: var(--foreground);
  }

  .demo {
    padding: 0.5rem 1rem;
    font-size: 0.9375rem;
    white-space: nowrap;
  }

  /* Phones: shrink every header element together so the wordmark, theme
     toggle, GitHub link and demo button fit on one comfortable row. */
  @media (max-width: 36rem) {
    /* The bar keeps its desktop height, so the smaller elements sit with
       room above and below them. */
    .wordmark img {
      height: 2.25rem;
    }

    nav {
      gap: 0.625rem;
      --theme-toggle-size: 1.875rem;
    }

    .gh {
      --gh-icon-size: 1.25rem;
    }

    .demo {
      padding: 0.375rem 0.75rem;
      font-size: 0.8125rem;
    }
  }

  @media (max-width: 26rem) {
    .bar {
      padding-inline: 1rem;
    }

    nav {
      gap: 0.5rem;
    }
  }

  @media (max-width: 23rem) {
    nav {
      gap: 0.375rem;
    }

    .wordmark img {
      height: 1.75rem;
    }

    .demo {
      padding-inline: 0.625rem;
    }
  }
</style>
