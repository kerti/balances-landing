---
import { GITHUB_URL, DEMO_URL } from '../consts';
import GithubIcon from './GithubIcon.astro';

const sections = [
  { href: '#how-it-works', label: 'How it works' },
  { href: '#why-monthly', label: 'Why monthly' },
  { href: '#what-it-tracks', label: 'What it tracks' },
  { href: '#report', label: 'Report' },
  { href: '#open-source', label: 'Open source' },
];
---

<header>
  <div class="container bar">
    <a class="wordmark" href="/">
      <img
        class="wordmark-light"
        src="/brand/wordmark-light.svg"
        alt="Balances"
        width="142"
        height="44"
      />
      <img
        class="wordmark-dark"
        src="/brand/wordmark-dark.svg"
        alt="Balances"
        width="142"
        height="44"
      />
    </a>
    <nav>
      <ul class="sections">
        {sections.map((section) => (
          <li>
            <a href={section.href}>{section.label}</a>
          </li>
        ))}
      </ul>
      <a class="gh" href={GITHUB_URL} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <GithubIcon />
      </a>
      <a
        class="button button-primary demo"
        href={DEMO_URL}
        target="_blank"
        rel="noopener noreferrer"
      >
        Try the demo
      </a>
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in oklch, var(--background) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .sections {
    display: none;
    gap: 1.5rem;
    margin: 0 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  /* Section links only where there is room; on phones the header keeps just
     the GitHub link and the demo button. */
  @media (min-width: 56rem) {
    .sections {
      display: flex;
    }
  }

  .sections a {
    color: var(--muted-foreground);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }

  .sections a:hover {
    color: var(--foreground);
  }

  .sections a:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.6875rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
  }

  .wordmark img {
    display: none;
    height: 3rem;
    width: auto;
  }

  .wordmark img.wordmark-light {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    .wordmark img.wordmark-light {
      display: none;
    }

    .wordmark img.wordmark-dark {
      display: block;
    }
  }

  nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .gh {
    display: inline-flex;
    color: var(--muted-foreground);
    --gh-icon-size: 1.5rem;
  }

  .gh:hover {
    color: var(--foreground);
  }

  .demo {
    padding: 0.5rem 1rem;
    font-size: 0.9375rem;
    white-space: nowrap;
  }

  @media (max-width: 26rem) {
    .bar {
      padding-inline: 1rem;
    }

    nav {
      gap: 0.5rem;
    }

    .demo {
      padding: 0.5rem 0.75rem;
    }
  }

  @media (max-width: 23rem) {
    nav {
      gap: 0.375rem;
    }

    .wordmark img {
      height: 2.5rem;
    }
  }
</style>
