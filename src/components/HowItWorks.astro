---
import { Image } from 'astro:assets';
import stepAdd from '../assets/screenshots/step-add.png';
import stepAddLight from '../assets/screenshots/step-add-light.png';
import stepEnter from '../assets/screenshots/step-enter.png';
import stepEnterLight from '../assets/screenshots/step-enter-light.png';
import stepWatch from '../assets/screenshots/step-watch.png';
import stepWatchLight from '../assets/screenshots/step-watch-light.png';

const facts = [
  'One number per position',
  'Straight off the statement',
  'About ten minutes',
  'No bank sync',
];

const steps = [
  {
    label: 'Add',
    title: 'Add your positions',
    body: 'Bank accounts, property, vehicles, investments, debts: anything your household owns or owes.',
    image: stepAdd,
    imageLight: stepAddLight,
    alt: 'A household’s bank accounts in Balances, each with its owner and latest month-end balance',
  },
  {
    label: 'Enter',
    title: 'Enter month‑end balances',
    body: 'Every position on one form, straight off the statement.',
    image: stepEnter,
    imageLight: stepEnterLight,
    alt: 'Entering a month’s balances in Balances: every bank account, property and vehicle on one form',
  },
  {
    label: 'Watch',
    title: 'Watch your net worth',
    body: 'Balances charts it month by month, across every position.',
    image: stepWatch,
    imageLight: stepWatchLight,
    alt: 'A household’s net worth in Balances, charted month by month over two years',
  },
];
---

<section id="how-it-works" class="container">
  <div class="intro">
    <p class="eyebrow" data-reveal="up">
      How it works
    </p>
    <h2 data-reveal>
      <span class="lead">Enter your balances</span>
      <span class="big">once a&nbsp;month.</span>
    </h2>
    <ul class="facts" data-reveal>
      {facts.map((fact, i) => (
        <li style={`--i: ${i}`}>{fact}</li>
      ))}
    </ul>
  </div>
  <ol>
    {steps.map((step, i) => (
      <li class:list={['step', { flip: i % 2 === 1 }]} data-reveal>
        <div class="copy">
          <span class="numeral" aria-hidden="true">
            {i + 1}
          </span>
          <p class="kicker">
            Step {i + 1} · {step.label}
          </p>
          <h3>{step.title}</h3>
          <p class="body">{step.body}</p>
        </div>
        <div class="shot">
          <Image class="light-only" src={step.imageLight} alt={step.alt} />
          <Image class="dark-only" src={step.image} alt={step.alt} />
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  section {
    padding-block: var(--section-pad-top) 4rem;
    border-top: 1px solid var(--border);
  }

  .intro {
    position: relative;
    padding-block: 1rem 0.5rem;
    text-align: center;
  }

  /* A faint brass glow behind the statement, carried over from the old
     standalone band. */
  .intro::before {
    content: '';
    position: absolute;
    inset: -2rem -1.5rem;
    z-index: -1;
    background: radial-gradient(
      50% 60% at 50% 55%,
      color-mix(in oklch, var(--glow) 9%, transparent),
      transparent 70%
    );
  }

  .lead {
    display: block;
    font-size: clamp(1.125rem, 2.5vw, 1.5rem);
    font-weight: 400;
    letter-spacing: normal;
    color: var(--muted-foreground);
  }

  .big {
    display: block;
    margin-top: 0.25rem;
    font-size: clamp(3.5rem, 13vw, 8.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.045em;
    color: var(--primary);
    text-shadow: 0 0 2rem color-mix(in oklch, var(--primary) 14%, transparent);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.625rem;
    margin: 2.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .facts li {
    padding: 0.375rem 0.875rem;
    border-radius: calc(var(--radius) * 0.6);
    background: var(--primary);
    color: var(--primary-foreground);
    font-size: 0.875rem;
    font-weight: 600;
    box-shadow: 0 0.25rem 0.75rem -0.375rem color-mix(in oklch, var(--primary) 35%, transparent);
  }

  .facts li:nth-child(odd) {
    transform: rotate(-1.5deg);
  }

  .facts li:nth-child(even) {
    transform: rotate(1.25deg);
  }

  /* Phones: a 2×2 sheet of equal stamps, wrapping inside, rather than rows of
     one, one and two. Edge to edge, a stamp's tilt and its oversized start
     (see the motion below) would poke past the screen, so the section clips
     sideways here. */
  @media (max-width: 36rem) {
    section {
      overflow-x: clip;
    }

    .facts {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: 1fr;
    }

    .facts li {
      display: grid;
      place-items: center;
      text-align: center;
    }
  }

  ol {
    list-style: none;
    margin: 5rem 0 0;
    padding: 0;
    display: grid;
    gap: 4.5rem;
  }

  .step {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  /* Side by side only where the screenshot still reads; narrower (a portrait
     tablet), it stacks under the copy at full width. */
  @media (min-width: 64rem) {
    .step {
      grid-template-columns: 2fr 3fr;
      gap: 4rem;
    }

    .step.flip {
      grid-template-columns: 3fr 2fr;
    }

    .step.flip .copy {
      order: 2;
    }
  }

  /* Oversized outlined numeral, drawn as a brass stroke over the background. */
  .numeral {
    display: block;
    font-size: clamp(5rem, 11vw, 8rem);
    font-weight: 600;
    line-height: 0.9;
    color: transparent;
    -webkit-text-stroke: 2px var(--primary);
  }

  .kicker {
    margin-top: 1.25rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--primary);
  }

  h3 {
    margin-top: 0.5rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
  }

  .body {
    margin-top: 0.75rem;
    font-size: 1.0625rem;
    color: var(--muted-foreground);
  }

  .shot {
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) * 1.4);
    overflow: hidden;
    background: var(--card);
    box-shadow: var(--shot-shadow);
  }

  .shot img {
    display: block;
  }

  /* Motion (paused until in view; see global.css). The statement rises, the
     chips stamp down one by one, and each step's copy slides in from its
     side while the screenshot rises. Individual transform properties keep
     the chips' resting tilt intact. */
  @media (prefers-reduced-motion: no-preference) {
    .lead {
      animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    .big {
      animation: rise-big 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) 0.12s both;
    }

    .facts li {
      animation: stamp 0.45s cubic-bezier(0.3, 1.4, 0.5, 1) both;
      animation-delay: calc(0.35s + var(--i) * 0.12s);
    }

    .step .copy {
      animation: rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    .step .shot {
      animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) 0.15s both;
    }
  }

  /* Side slides only where the steps sit side by side; on phones a sideways
     start could poke past the screen edge. */
  @media (prefers-reduced-motion: no-preference) and (min-width: 64rem) {
    .step .copy {
      animation-name: slide-from-left;
    }

    .step.flip .copy {
      animation-name: slide-from-right;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 1.5rem;
    }
  }

  @keyframes rise-big {
    from {
      opacity: 0;
      translate: 0 2rem;
      scale: 0.96;
    }
  }

  @keyframes stamp {
    from {
      opacity: 0;
      scale: 1.35;
    }
  }

  @keyframes slide-from-left {
    from {
      opacity: 0;
      translate: -2rem 0;
    }
  }

  @keyframes slide-from-right {
    from {
      opacity: 0;
      translate: 2rem 0;
    }
  }
</style>
