---
import { Image } from 'astro:assets';
import investments from '../assets/screenshots/investments.png';

const groups = [
  {
    name: 'Assets',
    icon: 'M3 10.5 12 3l9 7.5M5 9v11h14V9M10 20v-6h4v6',
    body: 'Bank accounts, property, vehicles — things of value that aren’t investment instruments.',
  },
  {
    name: 'Liabilities',
    icon: 'M3 7l6 6 4-4 8 8M21 11v6h-6',
    body: 'Mortgages, bank loans, credit-card balances — and the informal money owed to family.',
  },
  {
    name: 'Receivables',
    icon: 'M12 3v12m0 0-4-4m4 4 4-4M4 15v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4',
    body: 'Money owed to your household by someone else, so it stops falling through the cracks.',
  },
  {
    name: 'Investments',
    icon: 'M3 17l6-6 4 4 8-8M15 7h6v6',
    body: 'Stocks, mutual funds, bonds, gold, time deposits — with a ledger for buys, sells, and income.',
  },
];
---

<section id="what-it-tracks" class="container">
  <p class="eyebrow">What it tracks</p>
  <h2>
    Everything in <span class="accent">one place</span>
  </h2>
  <p class="lede">
    Net worth only means something when it covers the whole picture — including the illiquid things
    that have no transactions to sync.
  </p>
  <div class="cards">
    {groups.map((group) => (
      <div class="card">
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d={group.icon} />
          </svg>
        </span>
        <h3>{group.name}</h3>
        <p>{group.body}</p>
      </div>
    ))}
  </div>
  <div class="shot">
    <Image
      src={investments}
      alt="Investments overview in Balances, with all four position groups in the navigation"
    />
  </div>
</section>

<style>
  section {
    padding-block: 4rem;
    text-align: center;
  }

  h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
  }

  .lede {
    max-width: 54rem;
    margin: 1.25rem auto 0;
    color: var(--muted-foreground);
    font-size: 1.0625rem;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
    margin-top: 2.5rem;
    text-align: left;
  }

  .card {
    background: var(--card);
    color: var(--card-foreground);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .icon {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 1rem;
    border-radius: calc(var(--radius) * 0.8);
    background: color-mix(in oklch, var(--primary) 14%, transparent);
    color: var(--primary);
  }

  .icon svg {
    width: 1.375rem;
    height: 1.375rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  h3 {
    font-size: 1.125rem;
    font-weight: 650;
    color: var(--primary);
  }

  .card p {
    margin-top: 0.5rem;
    color: var(--muted-foreground);
    font-size: 0.9375rem;
  }

  .shot {
    margin-top: 3rem;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) * 1.4);
    overflow: hidden;
    background: var(--card);
    box-shadow:
      0 2rem 3.5rem -1.5rem color-mix(in oklch, var(--primary) 45%, transparent),
      0 1.5rem 3rem -1.5rem oklch(0.147 0.004 49.25 / 25%);
  }

  .shot img {
    display: block;
  }
</style>
