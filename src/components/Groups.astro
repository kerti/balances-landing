---
import { icons } from './icons';
import { Image } from 'astro:assets';
import { widthsFor } from './image-widths';
import appInvestments from '../assets/screenshots/app-investments.png';
import appInvestmentsLight from '../assets/screenshots/app-investments-light.png';

const groups = [
  {
    name: 'Assets',
    icon: icons.home,
    body: 'Bank accounts, property, vehicles: things of value that aren’t investment instruments.',
  },
  {
    name: 'Liabilities',
    icon: icons.receipt,
    body: 'Mortgages, bank loans, credit-card balances, and the informal money owed to family.',
  },
  {
    name: 'Receivables',
    icon: icons.coinShare,
    body: 'Money owed to your household by someone else, so it stops falling through the cracks.',
  },
  {
    name: 'Investments',
    icon: icons.dollarIncrease,
    body: 'Stocks, mutual funds, bonds, gold, and time deposits, with a ledger for buys, sells, and income.',
  },
];

// The screenshot spans the container: 68rem less 1.5rem padding a side.
const shotSizes = '(min-width: 68rem) 65rem, calc(100vw - 3rem)';
---

<section id="what-it-tracks" class="container">
  <p class="eyebrow" data-reveal="up">
    What it tracks
  </p>
  <h2 data-reveal="up" style="--reveal-delay: 0.08s">
    Everything in <span class="accent">one place</span>
  </h2>
  <p class="lede" data-reveal="up" style="--reveal-delay: 0.16s">
    Net worth only means something when it covers the whole picture, including the illiquid things
    with no transactions to sync.
  </p>
  <div class="cards" data-reveal>
    {groups.map((group, i) => (
      <div class="card" style={`--i: ${i}`}>
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 14 14">
            {group.icon.map((d) => (
              <path d={d} pathLength="1" />
            ))}
          </svg>
        </span>
        <h3>{group.name}</h3>
        <p>{group.body}</p>
      </div>
    ))}
  </div>
  <div class="shot" data-reveal="up">
    <Image
      class="light-only"
      src={appInvestmentsLight}
      widths={widthsFor(appInvestmentsLight.width)}
      sizes={shotSizes}
      alt="Investments overview in Balances, with all four position groups in the navigation"
    />
    <Image
      class="dark-only"
      src={appInvestments}
      widths={widthsFor(appInvestments.width)}
      sizes={shotSizes}
      alt="Investments overview in Balances, with all four position groups in the navigation"
    />
  </div>
</section>

<style>
  section {
    padding-block: var(--section-pad-top) 4rem;
    border-top: 1px solid var(--border);
    text-align: center;
  }

  h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
  }

  .lede {
    max-width: 54rem;
    margin: 1.25rem auto 0;
    color: var(--muted-foreground);
    font-size: 1.0625rem;
  }

  .cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 2.5rem;
    text-align: left;
  }

  /* Four cards: a 2×2 on tablets, one row only where all four fit, so none is
     ever left alone on a row. */
  @media (min-width: 36rem) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .cards {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .card {
    background: var(--card);
    color: var(--card-foreground);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  /* Frameless line icons, drawn larger so their soft, rounded strokes carry
     on their own. */
  .icon {
    display: block;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 1rem;
    color: var(--primary);
  }

  .icon svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 0.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  h3 {
    font-size: 1.125rem;
    font-weight: 650;
    color: var(--primary);
  }

  .card p {
    margin-top: 0.5rem;
    color: var(--muted-foreground);
    font-size: 0.9375rem;
    text-wrap: balance;
  }

  .shot {
    margin-top: 3rem;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) * 1.4);
    overflow: hidden;
    background: var(--card);
    box-shadow: var(--shot-shadow);
  }

  .shot img {
    display: block;
  }

  /* Motion (paused until in view; see global.css): cards stagger up and
     their line icons draw themselves. */
  @media (prefers-reduced-motion: no-preference) {
    .card {
      animation: reveal-up 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-delay: calc(var(--i) * 0.09s);
    }

    .icon path {
      stroke-dasharray: 1;
      animation: draw-stroke 0.9s ease-out both;
      animation-delay: calc(0.25s + var(--i) * 0.09s);
    }
  }
</style>
