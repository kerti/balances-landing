---
import { icons } from './icons';
import { GITHUB_URL, SELF_HOST_URL } from '../consts';

const points = [
  {
    title: 'Docker Compose',
    body: 'A released image and PostgreSQL, started with',
    code: 'docker compose up',
    after: '. Nothing to build.',
    icon: icons.database,
  },
  {
    title: 'Backup & export',
    body: 'Back up or export the whole household whenever you like.',
    icon: icons.archiveBox,
  },
  {
    title: 'Translatable',
    body: 'English and Bahasa Indonesia, chosen per person and saved to their account. Numbers and dates follow the language.',
    icon: icons.dictionary,
  },
];
---

<section id="open-source">
  <div class="container">
    <p class="eyebrow" data-reveal="up">
      Open source
    </p>
    <h2 data-reveal="up" style="--reveal-delay: 0.08s">
      Yours <span class="accent">to run</span>
    </h2>
    <p class="lede" data-reveal="up" style="--reveal-delay: 0.16s">
      Your household’s net worth lives where you put it.
    </p>
    <ul class="points" data-reveal>
      {points.map((point, i) => (
        <li style={`--i: ${i}`}>
          <span class="icon" aria-hidden="true">
            <svg viewBox="0 0 14 14">
              {point.icon.map((d) => (
                <path d={d} pathLength="1" />
              ))}
            </svg>
          </span>
          <h3>{point.title}</h3>
          <p>
            {point.body}
            {point.code && (
              <>
                {' '}
                <code>{point.code}</code>
                {point.after}
              </>
            )}
          </p>
        </li>
      ))}
    </ul>
    <p class="note">
      Self-hosting means upgrades, backups and HTTPS are yours to look after. The guide walks
      through each.
    </p>
    <div class="cta">
      <a
        class="button button-primary"
        href={SELF_HOST_URL}
        target="_blank"
        rel="noopener noreferrer"
      >
        Self-hosting guide
      </a>
      <a
        class="button button-secondary"
        href={GITHUB_URL}
        target="_blank"
        rel="noopener noreferrer"
      >
        View the source
      </a>
    </div>
  </div>
</section>

<style>
  section {
    border-top: 1px solid var(--border);
  }

  .container {
    padding-block: var(--section-pad-top) 4rem;
    max-width: 68rem;
    text-align: center;
  }

  h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--secondary-foreground);
  }

  p {
    margin-top: 1.25rem;
    font-size: 1.0625rem;
    color: var(--muted-foreground);
  }

  .points {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  /* Three cards: stacked, then all three in a row. Never two columns, which
     would leave one alone on a row. */
  @media (min-width: 48rem) {
    .points {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .points li {
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
  }

  /* Frameless line icons, drawn larger so their soft, rounded strokes carry
     on their own. */
  .icon {
    display: block;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 1rem;
    color: var(--primary);
  }

  .icon svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 0.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  h3 {
    font-size: 1.0625rem;
    font-weight: 650;
    color: var(--card-foreground);
  }

  .points p {
    margin-top: 0.375rem;
    font-size: 0.9375rem;
    text-wrap: balance;
  }

  code {
    white-space: nowrap;
    font-size: 0.9375em;
    color: var(--secondary-foreground);
  }

  /* What running it yourself takes, just above the guide that covers it. */
  .note {
    max-width: 40rem;
    margin: 2rem auto 0;
    font-size: 0.9375rem;
    text-wrap: balance;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  /* Motion (paused until in view; see global.css): cards stagger up and
     their line icons draw themselves. */
  @media (prefers-reduced-motion: no-preference) {
    .points li {
      animation: reveal-up 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-delay: calc(var(--i) * 0.09s);
    }

    .icon path {
      stroke-dasharray: 1;
      animation: draw-stroke 0.9s ease-out both;
      animation-delay: calc(0.25s + var(--i) * 0.09s);
    }
  }
</style>
