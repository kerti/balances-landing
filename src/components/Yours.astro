---
import { GITHUB_URL, SELF_HOST_URL } from '../consts';

const points = [
  {
    title: 'Open source',
    body: 'The whole app is open-source under AGPL-3.0.',
    icon: 'M8 7l-5 5 5 5M16 7l5 5-5 5',
  },
  {
    title: 'Self-hosted',
    body: 'Run it on your own machine with a single',
    code: 'docker compose up',
    icon: 'M4 4h16v6H4zM4 14h16v6H4zM8 7h.01M8 17h.01',
  },
  {
    title: 'Backup & export',
    body: 'Back up or export the whole household whenever you like.',
    icon: 'M3 4h18v4H3zM5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8M10 12h4',
  },
  {
    title: 'Two languages',
    body: 'Use the app in English or Bahasa Indonesia.',
    icon: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z',
  },
];
---

<section id="open-source">
  <div class="container">
    <p class="eyebrow">Open source</p>
    <h2>
      Yours, <span class="accent">not a data product</span>
    </h2>
    <p class="lede">Your household’s net worth lives where you put it.</p>
    <ul class="points">
      {points.map((point) => (
        <li>
          <span class="icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d={point.icon} />
            </svg>
          </span>
          <h3>{point.title}</h3>
          <p>
            {point.body}
            {point.code && (
              <>
                {' '}
                <code>{point.code}</code>.
              </>
            )}
          </p>
        </li>
      ))}
    </ul>
    <div class="cta">
      <a
        class="button button-primary"
        href={SELF_HOST_URL}
        target="_blank"
        rel="noopener noreferrer"
      >
        Read the self-hosting guide
      </a>
      <a
        class="button button-secondary"
        href={GITHUB_URL}
        target="_blank"
        rel="noopener noreferrer"
      >
        View the source
      </a>
    </div>
  </div>
</section>

<style>
  section {
    background: var(--section-tint);
    border-top: 1px solid var(--border);
  }

  .container {
    padding-block: var(--section-pad-top) 4rem;
    max-width: 68rem;
    text-align: center;
  }

  h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--secondary-foreground);
  }

  p {
    margin-top: 1.25rem;
    font-size: 1.0625rem;
    color: var(--muted-foreground);
  }

  .points {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12.5rem, 1fr));
    gap: 1rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  .points li {
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
  }

  .icon {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 1rem;
    border-radius: calc(var(--radius) * 0.8);
    background: color-mix(in oklch, var(--primary) 14%, transparent);
    color: var(--primary);
  }

  .icon svg {
    width: 1.375rem;
    height: 1.375rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  h3 {
    font-size: 1.0625rem;
    font-weight: 650;
    color: var(--card-foreground);
  }

  .points p {
    margin-top: 0.375rem;
    font-size: 0.9375rem;
  }

  code {
    white-space: nowrap;
    font-size: 0.9375em;
    color: var(--secondary-foreground);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>
