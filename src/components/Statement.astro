---
const chips = [
  'One number per position',
  'Straight off the statement',
  'About ten minutes',
  'No bank sync',
];
---

<section>
  <div class="container">
    <p class="lead">Not every transaction. Just your balances,</p>
    <p class="big">once a&nbsp;month.</p>
    <ul class="chips">
      {chips.map((chip) => (
        <li>{chip}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  section {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--border);
  }

  section::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(
      50% 60% at 50% 55%,
      color-mix(in oklch, var(--glow) 16%, transparent),
      transparent 70%
    );
  }

  .container {
    padding-block: 6rem;
    text-align: center;
  }

  .lead {
    font-size: clamp(1.125rem, 2.5vw, 1.5rem);
    color: var(--muted-foreground);
  }

  .big {
    margin-top: 0.25rem;
    font-size: clamp(3.5rem, 13vw, 8.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.045em;
    color: var(--primary);
    text-shadow: 0 0 2.5rem color-mix(in oklch, var(--primary) 35%, transparent);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.625rem;
    margin: 2.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .chips li {
    padding: 0.375rem 0.875rem;
    border-radius: calc(var(--radius) * 0.6);
    background: var(--primary);
    color: var(--primary-foreground);
    font-size: 0.875rem;
    font-weight: 600;
    box-shadow: 0 0.375rem 1rem -0.5rem color-mix(in oklch, var(--primary) 70%, transparent);
  }

  .chips li:nth-child(odd) {
    transform: rotate(-1.5deg);
  }

  .chips li:nth-child(even) {
    transform: rotate(1.25deg);
  }
</style>
