---
import HeroIllustration from './HeroIllustration.astro';
import { DEMO_URL, SELF_HOST_URL } from '../consts';

const facts = [
  'AGPL-3.0 open source',
  'Self-host with docker compose',
  'No bank connections — you type the numbers',
  'Multi-currency',
];
---

<section>
  <div class="container inner">
    <div class="copy">
      <p class="eyebrow">Net worth for households</p>
      <h1>
        Track your net worth, <span class="accent">not&nbsp;your coffee&nbsp;money.</span>
      </h1>
      <p class="subhead">
        Each month you enter your balances; Balances tracks your net worth. One number per position,
        once a month. No receipt scanning, no transaction categorising, no bank-sync babysitting.
      </p>
      <p class="audience">
        Built for households who want to watch wealth build over years, not track spending week to
        week.
      </p>
      <div class="cta">
        <a class="button button-primary" href={DEMO_URL} target="_blank" rel="noopener noreferrer">
          Try the live demo
        </a>
        <a
          class="button button-secondary"
          href={SELF_HOST_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          Self-host it
        </a>
      </div>
      <p class="caveat">No signup — the demo is a shared account; its data resets nightly.</p>
      <ul class="facts">
        {facts.map((fact) => (
          <li>{fact}</li>
        ))}
      </ul>
    </div>
    <HeroIllustration />
  </div>
</section>

<style>
  /* Full width, so the illustration's earlier months can run out to the
     window edge; the container inside holds the content. */
  section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .inner {
    padding-block: 4.5rem 3rem;
    text-align: center;
  }

  /* Above the illustration, whose faint line runs out behind the copy. */
  .copy {
    position: relative;
    z-index: 1;
  }

  h1 {
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    font-weight: 700;
    max-width: 20ch;
    margin-inline: auto;
  }

  .subhead {
    max-width: 60rem;
    margin: 1.5rem auto 0;
    font-size: 1.1875rem;
    color: var(--muted-foreground);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .audience {
    max-width: 60rem;
    margin: 0.875rem auto 0;
    font-size: 1rem;
    color: var(--muted-foreground);
  }

  .caveat {
    margin-top: 0.875rem;
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: 1.75rem auto 0;
    padding: 0;
    list-style: none;
    max-width: 60rem;
  }

  .facts li {
    padding: 0.3125rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--secondary);
    color: var(--secondary-foreground);
    font-size: 0.8125rem;
    font-weight: 500;
    white-space: nowrap;
  }

  /* Phones: pull the hero up closer to the header. */
  @media (max-width: 36rem) {
    .inner {
      padding-top: var(--section-pad-top);
    }
  }

  @media (max-width: 30rem) {
    .facts li {
      white-space: normal;
    }
  }

  /* Wide screens: copy on the left, the idea drawn on the right, both above
     the fold. Narrower screens keep the centred stack. */
  @media (min-width: 64rem) {
    .inner {
      display: grid;
      grid-template-columns: 1.15fr 1fr;
      gap: 3.5rem;
      align-items: center;
      padding-block: 4rem 4.5rem;
      text-align: left;
    }

    h1,
    .subhead,
    .audience,
    .facts {
      margin-inline: 0;
    }

    .cta,
    .facts {
      justify-content: flex-start;
    }

    .subhead {
      font-size: 1.125rem;
    }
  }
</style>
