---
import { Image } from 'astro:assets';
import report from '../assets/screenshots/report.png';
---

<section class="container">
  <h2>A report, not just a dashboard</h2>
  <p class="lede">
    Every month, Balances generates a PDF report — the net-worth chart, the household's financial
    statistics, and a full breakdown by position — ready to save or share.
  </p>
  <div class="shot">
    <Image src={report} alt="A monthly PDF report generated by Balances" />
  </div>
</section>

<style>
  section {
    padding-block: 4rem;
    border-top: 1px solid var(--border);
    text-align: center;
  }

  h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
  }

  .lede {
    max-width: 54rem;
    margin: 1.25rem auto 0;
    color: var(--muted-foreground);
    font-size: 1.0625rem;
  }

  .shot {
    max-width: 36rem;
    margin: 2.5rem auto 0;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) * 1.4);
    overflow: hidden;
    background: var(--card);
    box-shadow:
      0 2rem 3.5rem -1.5rem color-mix(in oklch, var(--primary) 45%, transparent),
      0 1.5rem 3rem -1.5rem oklch(0.147 0.004 49.25 / 25%);
  }

  .shot img {
    display: block;
  }
</style>
