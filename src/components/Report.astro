---
import { Image } from 'astro:assets';
import report from '../assets/screenshots/report.png';
---

<section id="report" class="container">
  <p class="eyebrow" data-reveal="up">
    Monthly report
  </p>
  <h2 data-reveal="up" style="--reveal-delay: 0.08s">
    A report, <span class="accent">not just a dashboard</span>
  </h2>
  <p class="lede" data-reveal="up" style="--reveal-delay: 0.16s">
    Every month, Balances generates a PDF report — the net-worth chart, the household's financial
    statistics, and a full breakdown by position — ready to save or share.
  </p>
  <div class="shot" data-reveal>
    <Image src={report} alt="A monthly PDF report generated by Balances" />
  </div>
</section>

<style>
  section {
    padding-block: var(--section-pad-top) 4rem;
    border-top: 1px solid var(--border);
    text-align: center;
  }

  h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
  }

  .lede {
    max-width: 54rem;
    margin: 1.25rem auto 0;
    color: var(--muted-foreground);
    font-size: 1.0625rem;
  }

  .shot {
    max-width: 36rem;
    margin: 2.5rem auto 0;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) * 1.4);
    overflow: hidden;
    background: var(--card);
    box-shadow: var(--shot-shadow);
  }

  .shot img {
    display: block;
  }

  /* Motion (paused until in view; see global.css): the report rises and
     settles, like a page landing on the desk. */
  @media (prefers-reduced-motion: no-preference) {
    .shot {
      animation: land 1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.1s both;
    }
  }

  @keyframes land {
    from {
      opacity: 0;
      translate: 0 2.5rem;
      rotate: -2deg;
    }
  }
</style>
