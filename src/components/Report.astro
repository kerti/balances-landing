---
import { Image } from 'astro:assets';
import report1 from '../assets/screenshots/report-1.png';
import report2 from '../assets/screenshots/report-2.png';
import report3 from '../assets/screenshots/report-3.png';
import report4 from '../assets/screenshots/report-4.png';
import report5 from '../assets/screenshots/report-5.png';

// The demo household's monthly PDF, page by page (its near-empty last page,
// a spill-over total and the exchange rate, is left out). The footers' app
// version is painted out: no version numbers on this page (CONTEXT.md).
const pages = [
  {
    src: report1,
    alt: 'net worth, its 12-month chart, and how assets, investments and debts split',
  },
  { src: report2, alt: 'the household’s financial statistics and the month’s cash flow' },
  { src: report3, alt: 'every asset, by group and owner' },
  { src: report4, alt: 'liabilities and receivables' },
  { src: report5, alt: 'investment performance and every holding' },
];
---

<section id="report" class="container">
  <p class="eyebrow" data-reveal="up">
    Monthly report
  </p>
  <h2 data-reveal="up" style="--reveal-delay: 0.08s">
    A report, <span class="accent">not just a dashboard</span>
  </h2>
  <p class="lede" data-reveal="up" style="--reveal-delay: 0.16s">
    Every month, Balances generates a PDF report — the net-worth chart, the household's financial
    statistics, and a full breakdown by position — ready to save or share.
  </p>
  <div class="pager" data-reveal>
    <div class="shot">
      <ol class="pages" tabindex="0" aria-label="Pages of a monthly report">
        {pages.map((page, i) => (
          <li>
            <Image
              src={page.src}
              alt={`Monthly report, page ${i + 1}: ${page.alt}`}
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          </li>
        ))}
      </ol>
    </div>
    <div class="controls" hidden>
      <button class="step prev" type="button" aria-label="Previous page">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m15 6-6 6 6 6"></path>
        </svg>
      </button>
      <div class="dots">
        {pages.map((_, i) => (
          <button class="dot" type="button" aria-label={`Page ${i + 1}`} data-page={i} />
        ))}
      </div>
      <button class="step next" type="button" aria-label="Next page">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m9 6 6 6-6 6"></path>
        </svg>
      </button>
      <button class="play" type="button" aria-label="Pause slideshow" hidden>
        <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9 6v12M15 6v12"></path>
        </svg>
        <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 5.5v13l10-6.5z"></path>
        </svg>
      </button>
    </div>
  </div>
</section>

<style>
  section {
    padding-block: var(--section-pad-top) 4rem;
    border-top: 1px solid var(--border);
    text-align: center;
  }

  h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
  }

  .lede {
    max-width: 54rem;
    margin: 1.25rem auto 0;
    color: var(--muted-foreground);
    font-size: 1.0625rem;
  }

  /* Narrow enough on short screens (a landscape tablet) that the whole page
     and its controls fit under the header: the page is 1190 by 1683, and the
     header, the gap above and the controls take about 10rem. Never below
     20rem, where the page would be too small to read. */
  .pager {
    position: relative;
    max-width: clamp(20rem, (100svh - var(--header-height) - 5.5rem) * 1190 / 1683, 36rem);
    margin: 2.5rem auto 0;
  }

  .shot {
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) * 1.4);
    overflow: hidden;
    background: var(--card);
    box-shadow: var(--shot-shadow);
  }

  /* One page at a time, snapping. Swipe or scroll it without JS; the script
     below adds the buttons and hides the scrollbar. */
  .pages {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
  }

  .pager[data-enhanced] .pages {
    scrollbar-width: none;
  }

  .pager[data-enhanced] .pages::-webkit-scrollbar {
    display: none;
  }

  .pages:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: -2px;
  }

  .pages li {
    flex: 0 0 100%;
    scroll-snap-align: start;
  }

  .pages img {
    display: block;
  }

  .controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .controls[hidden] {
    display: none;
  }

  /* A page is taller than most windows, so on wider screens the arrows sit
     beside it, halfway down, where they stay in view while reading; the dots
     stay underneath. */
  @media (min-width: 48rem) {
    .step {
      position: absolute;
      top: 50%;
      translate: 0 -50%;
      width: 2.75rem;
      height: 2.75rem;
    }

    .prev {
      left: -4.5rem;
    }

    .next {
      right: -4.5rem;
    }
  }

  .step {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--card);
    color: var(--foreground);
    cursor: pointer;
  }

  .step:hover:not(:disabled) {
    border-color: var(--primary);
    color: var(--primary);
  }

  .step:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .step svg {
    width: 1.125rem;
    height: 1.125rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Pause/play for the slideshow (WCAG 2.2.2: anything that moves on its own
     for more than five seconds needs a way to stop it). */
  .play {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--muted-foreground);
    cursor: pointer;
  }

  .play[hidden] {
    display: none;
  }

  .play:hover {
    color: var(--primary);
  }

  .play svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .play .icon-play {
    fill: currentColor;
  }

  .play:not([data-playing]) .icon-pause,
  .play[data-playing] .icon-play {
    display: none;
  }

  .play:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  /* Dots, not "1 of 5": each page's own footer already counts its pages. */
  .dots {
    display: flex;
    gap: 0.5rem;
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: var(--border);
    cursor: pointer;
    transition:
      width 0.2s ease,
      background-color 0.2s ease;
  }

  .dot[aria-current='true'] {
    width: 1.25rem;
    background: var(--primary);
  }

  .step:focus-visible,
  .dot:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  /* Motion (paused until in view; see global.css): the report rises and
     settles, like a page landing on the desk. */
  @media (prefers-reduced-motion: no-preference) {
    .shot {
      animation: land 1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.1s both;
    }
  }

  @keyframes land {
    from {
      opacity: 0;
      translate: 0 2.5rem;
      rotate: -2deg;
    }
  }
</style>

<script>
  // Previous/next buttons, page dots and a looping slideshow for the report
  // pages. The strip itself scrolls and snaps natively, so this only steers it
  // and reflects where it is.
  const INTERVAL = 6000;

  for (const pager of document.querySelectorAll<HTMLElement>('.pager')) {
    const strip = pager.querySelector<HTMLElement>('.pages')!;
    const controls = pager.querySelector<HTMLElement>('.controls')!;
    const prev = pager.querySelector<HTMLButtonElement>('.prev')!;
    const next = pager.querySelector<HTMLButtonElement>('.next')!;
    const play = pager.querySelector<HTMLButtonElement>('.play')!;
    const dots = [...pager.querySelectorAll<HTMLButtonElement>('.dot')];
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');

    const current = () => Math.round(strip.scrollLeft / strip.clientWidth);
    const go = (page: number) =>
      strip.scrollTo({
        left: page * strip.clientWidth,
        behavior: reduced.matches ? 'auto' : 'smooth',
      });

    const update = () => {
      const page = current();
      prev.disabled = page === 0;
      next.disabled = page === dots.length - 1;
      dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === page)));
    };

    // The slideshow: a page every INTERVAL, looping back to the first. It
    // holds while the pointer or focus is on the pager, while it's off screen
    // or the tab is hidden, and stops for good once someone takes over (an
    // arrow, a dot, a swipe) or presses pause. Never with reduced motion.
    let stopped = reduced.matches;
    const held = { hover: false, focus: false };
    let inView = false;
    let timer = 0;

    const schedule = () => {
      clearTimeout(timer);
      play.toggleAttribute('data-playing', !stopped);
      play.setAttribute('aria-label', stopped ? 'Play slideshow' : 'Pause slideshow');
      if (stopped || held.hover || held.focus || !inView || document.hidden) return;
      timer = window.setTimeout(() => {
        go((current() + 1) % dots.length);
        schedule();
      }, INTERVAL);
    };

    const stop = () => {
      stopped = true;
      schedule();
    };

    prev.addEventListener('click', () => (stop(), go(current() - 1)));
    next.addEventListener('click', () => (stop(), go(current() + 1)));
    for (const dot of dots)
      dot.addEventListener('click', () => (stop(), go(Number(dot.dataset.page))));
    play.addEventListener('click', () => {
      stopped = !stopped;
      schedule();
    });

    // Someone handling the strip directly: a touch, a drag, a sideways scroll
    // or the arrow keys while it has focus.
    strip.addEventListener('pointerdown', stop);
    strip.addEventListener('keydown', stop);
    strip.addEventListener('wheel', (event) => {
      if (Math.abs(event.deltaX) > Math.abs(event.deltaY)) stop();
    });

    pager.addEventListener('mouseenter', () => ((held.hover = true), schedule()));
    pager.addEventListener('mouseleave', () => ((held.hover = false), schedule()));
    pager.addEventListener('focusin', () => ((held.focus = true), schedule()));
    pager.addEventListener('focusout', (event) => {
      held.focus = pager.contains(event.relatedTarget as Node | null);
      schedule();
    });
    document.addEventListener('visibilitychange', schedule);
    new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        schedule();
      },
      { threshold: 0.5 },
    ).observe(pager);

    let frame = 0;
    strip.addEventListener('scroll', () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(update);
    });

    pager.dataset.enhanced = '';
    controls.hidden = false;
    play.hidden = reduced.matches;
    update();
    schedule();
  }
</script>
